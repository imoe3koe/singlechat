<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SINGLECHAT"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Satu Kelompok, Satu Obrolan"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:layout_marginBottom="32dp"/>

    <!-- Form Email -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:background="@drawable/border_box"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp"/>

    <!-- Form Password -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:background="@drawable/border_box"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp"/>

    <!-- Form Token Kelompok (Opsional untuk Anggota, Kosongkan jika Ketua Baru) -->
    <EditText
        android:id="@+id/etGroupToken"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Token Kelompok (Kosongkan jika ingin buat baru)"
        android:background="@drawable/border_box"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp"/>

    <!-- Tombol Login -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="MASUK"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Tombol Daftar -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="DAFTAR KELOMPOK BARU / GABUNG"
        android:textColor="@color/black"
        android:background="@drawable/border_box"
        android:textSize="11sp"
        android:textStyle="bold"/>

</LinearLayout>